 			g_set_error (error,
 				     CD_CLIENT_ERROR,
 				     CD_CLIENT_ERROR_INTERNAL,
 				     "Failed to migrate mappings: SQL error: %s",
-				     error_msg);
-			sqlite3_free (error_msg);
+				     sqlite3_errmsg(priv->db));
 			return FALSE;
 		}
 
 		/* remove old table data */
 		statement = "DELETE FROM mappings;";
 		rc = sqlite3_exec (priv->db, statement,
-				   NULL, NULL, &error_msg);
+				   NULL, NULL, NULL);
 		if (rc != SQLITE_OK) {
 			g_set_error (error,
 				     CD_CLIENT_ERROR,
 				     CD_CLIENT_ERROR_INTERNAL,
 				     "Failed to migrate mappings: SQL error: %s",
