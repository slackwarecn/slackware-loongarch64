# See also /etc/default/rpc

# Optional arguments passed to rpc.nfsd. See rpc.nfsd(8)
# Turn off v3 protocol support:
#RPC_NFSD_OPTS="-N 3"
# Turn off v4 protocol support:
#RPC_NFSD_OPTS="-N 4"
# Number of nfs server processes to be started.
# The default is 8.
#RPC_NFSD_COUNT=8

# Additional options for rpc.gssd:
#RPC_GSSD_OPTS=""

# Additional options for rpc.svcgssd:
#RPC_SVCGSSD_OPTS=""

# Additional options for rpc.idmapd:
#RPC_IDMAPD_OPTS=""
